---
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import JourneyOrbit from "../components/effects/JourneyOrbit.astro";

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("Friends page content not found");
}

const { Content } = await render(friendsPost);
const friends = friendsPost.data.friends ?? [];
const friendRules = friendsPost.data.friendRules ?? [];
const friendApplication = friendsPost.data.friendApplication;
const siteInfo = friendsPost.data.siteInfo;

function getDomain(rawUrl: string) {
	try {
		return new URL(rawUrl).hostname.replace(/^www\./, "");
	} catch {
		return rawUrl;
	}
}
---

<MainGridLayout title="友之屋" description="友情链接">
	<section class="friends-shell card-base relative overflow-hidden px-5 py-6 sm:px-8 sm:py-8">
		<div class="friends-orb friends-orb-one" aria-hidden="true"></div>
		<div class="friends-orb friends-orb-two" aria-hidden="true"></div>

		<header class="friends-header relative z-10">
            <JourneyOrbit />
			<div class="friends-header-copy">
				<div class="journey-section-overline">FRIEND LINKS / 同行者</div>
				<div class="friends-intro prose dark:prose-invert max-w-none [&_.anchor]:hidden">
					<Content />
				</div>
			</div>
			<div class="friend-count shrink-0">
				<strong>{String(friends.length).padStart(2, "0")}</strong>
				<span>位同行者</span>
			</div>
		</header>

		<div class="relative z-10 mt-7">
			{
				friends.length > 0 && (
					<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
						{friends.map((friend, index) => (
							<a
								href={friend.url}
								target="_blank"
								rel="noopener noreferrer"
								class="friend-card group relative flex min-h-44 flex-col overflow-hidden rounded-[var(--radius-large)] border border-black/[0.07] bg-white/50 p-5 no-underline shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-[var(--primary)]/35 hover:shadow-xl dark:border-white/[0.08] dark:bg-white/[0.035]"
								style={`--friend-hue: ${205 + index * 38}`}
								aria-label={`访问 ${friend.name}（新窗口打开）`}
							>
								<div class="friend-card-glow" aria-hidden="true"></div>
								<div class="relative z-10 flex items-start justify-between gap-4">
									<div class="friend-avatar-ring">
										<img
											src={friend.avatar}
											alt={`${friend.name} 的头像`}
											class="friend-avatar"
											width="72"
											height="72"
											loading="lazy"
											decoding="async"
										/>
									</div>
									<span class="grid h-9 w-9 place-items-center rounded-full bg-black/[0.045] text-black/40 transition-all duration-300 group-hover:rotate-6 group-hover:bg-[var(--primary)] group-hover:text-white dark:bg-white/[0.07] dark:text-white/45">
										<Icon name="material-symbols:arrow-outward-rounded" class="text-lg" />
									</span>
								</div>
								<div class="relative z-10 mt-5">
									<h2 class="m-0 text-xl font-bold text-black/85 transition group-hover:text-[var(--primary)] dark:text-white/90">{friend.name}</h2>
									<div class="mt-1.5 flex items-center gap-1.5 text-xs font-medium text-black/35 dark:text-white/35">
										<Icon name="material-symbols:language" class="text-sm" />
										<span class="truncate">{getDomain(friend.url)}</span>
									</div>
									{friend.description && <p class="mb-0 mt-3 text-sm leading-6 text-black/60 dark:text-white/60">{friend.description}</p>}
								</div>
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>

	<section class="friend-guide card-base relative mt-4 overflow-hidden px-5 py-6 sm:px-8 sm:py-8">
		<div class="guide-grid">
			<div>
				<div class="section-kicker">
					<Icon name="material-symbols:handshake-outline-rounded" />
					LINK EXCHANGE
				</div>
				<h2 class="section-title">交换规则</h2>
				<p class="section-lead">认真经营的小站，值得被认真地介绍。</p>
				<ul class="rule-list">
					{friendRules.map((rule) => (
						<li>
							<span class="rule-check"><Icon name="material-symbols:check-rounded" /></span>
							<span>{rule}</span>
						</li>
					))}
				</ul>
			</div>

			<div class="application-card">
				<div class="application-icon"><Icon name="material-symbols:outgoing-mail-rounded" /></div>
				<div>
					<h2 class="section-title !text-xl">申请方式</h2>
					<p>{friendApplication?.description}</p>
				</div>
				{friendApplication && (
					<a class="mail-button" href={`mailto:${friendApplication.email}?subject=${encodeURIComponent("申请交换友链")}`}>
						<Icon name="fa6-regular:envelope" />
						联系我
					</a>
				)}
			</div>
		</div>

		{siteInfo && (
			<div class="site-info">
				<div class="site-info-title">
					<Icon name="material-symbols:badge-outline-rounded" />
					<div><span>本站友链信息</span><small>复制以下内容即可添加本站</small></div>
				</div>
				<dl>
					<div><dt>站点名称</dt><dd>{siteInfo.name}</dd></div>
					<div><dt>站点链接</dt><dd><a href={siteInfo.url}>{siteInfo.url}</a></dd></div>
					<div><dt>站点简介</dt><dd>{siteInfo.description}</dd></div>
					<div><dt>头像 / 图标</dt><dd><a href={siteInfo.avatar} target="_blank" rel="noopener noreferrer">{siteInfo.avatar}</a></dd></div>
				</dl>
			</div>
		)}
	</section>

</MainGridLayout>

<style>
	.friends-shell {
		isolation: isolate;
		border: 1px solid rgb(255 255 255 / 0.2);
	}

	.friends-orb {
		position: absolute;
		z-index: -1;
		border-radius: 9999px;
		filter: blur(2px);
		pointer-events: none;
	}

	.friends-orb-one {
		top: -8rem;
		right: -6rem;
		width: 20rem;
		height: 20rem;
		background: color-mix(in oklch, var(--primary) 16%, transparent);
	}

	.friends-orb-two {
		bottom: -10rem;
		left: 18%;
		width: 22rem;
		height: 16rem;
		background: color-mix(in oklch, oklch(0.78 0.1 190) 12%, transparent);
	}

	.friend-count {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.65rem 0.9rem;
		border-radius: 0.85rem;
		background: rgb(255 255 255 / 0.45);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.05);
	}

	:global(.dark) .friend-count {
		background: rgb(255 255 255 / 0.05);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
	}

	.friend-count strong {
		font-size: 1.35rem;
		line-height: 1;
		color: var(--primary);
		font-variant-numeric: tabular-nums;
	}

	.friend-count span {
		font-size: 0.75rem;
		font-weight: 600;
		color: rgb(0 0 0 / 0.45);
	}

	:global(.dark) .friend-count span {
		color: rgb(255 255 255 / 0.45);
	}

	.friend-card-glow {
		position: absolute;
		top: -5rem;
		left: -5rem;
		width: 10rem;
		height: 10rem;
		border-radius: 9999px;
		background: oklch(0.82 0.1 var(--friend-hue) / 0.22);
		transition: transform 400ms ease, opacity 400ms ease;
	}

	.friend-card:hover .friend-card-glow {
		transform: scale(1.35);
		opacity: 0.9;
	}

	.friend-avatar-ring {
		display: grid;
		width: 4.5rem;
		height: 4.5rem;
		place-items: center;
		border: 2px solid rgb(255 255 255 / 0.72);
		border-radius: 9999px;
		background: linear-gradient(145deg, oklch(0.9 0.075 var(--friend-hue) / 0.9), oklch(0.72 0.13 var(--friend-hue) / 0.86));
		box-shadow: 0 0.65rem 1.4rem oklch(0.55 0.08 var(--friend-hue) / 0.18);
	}

	.friend-avatar {
		display: block;
		width: calc(100% - 0.3rem);
		height: calc(100% - 0.3rem);
		border-radius: 9999px;
		object-fit: cover;
		object-position: center;
	}

	.friend-guide {
		isolation: isolate;
		border: 1px solid rgb(255 255 255 / 0.2);
	}

	.guide-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
		gap: 1.5rem;
	}

	.section-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.16em;
	}

	.section-kicker :global(svg) {
		font-size: 1rem;
	}

	.section-title {
		margin: 0.55rem 0 0;
		color: rgb(0 0 0 / 0.84);
		font-size: 1.75rem;
		font-weight: 800;
		line-height: 1.2;
	}

	:global(.dark) .section-title {
		color: rgb(255 255 255 / 0.9);
	}

	.section-lead {
		margin: 0.65rem 0 0;
		color: rgb(0 0 0 / 0.48);
		font-size: 0.88rem;
	}

	:global(.dark) .section-lead {
		color: rgb(255 255 255 / 0.48);
	}

	.rule-list {
		display: grid;
		gap: 0.8rem;
		margin: 1.4rem 0 0;
		padding: 0;
		list-style: none;
	}

	.rule-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		color: rgb(0 0 0 / 0.62);
		font-size: 0.9rem;
		line-height: 1.65;
	}

	:global(.dark) .rule-list li {
		color: rgb(255 255 255 / 0.62);
	}

	.rule-check {
		display: grid;
		flex: 0 0 auto;
		width: 1.45rem;
		height: 1.45rem;
		margin-top: 0.05rem;
		place-items: center;
		border-radius: 9999px;
		background: color-mix(in oklch, var(--primary) 15%, transparent);
		color: var(--primary);
	}

	.application-card {
		display: flex;
		align-content: flex-start;
		align-items: flex-start;
		flex-direction: column;
		gap: 1rem;
		padding: 1.35rem;
		border: 1px solid rgb(255 255 255 / 0.3);
		border-radius: 1.25rem;
		background: linear-gradient(145deg, color-mix(in oklch, var(--primary) 12%, white 62%), rgb(255 255 255 / 0.24));
	}

	:global(.dark) .application-card {
		border-color: rgb(255 255 255 / 0.09);
		background: linear-gradient(145deg, color-mix(in oklch, var(--primary) 18%, rgb(21 27 38) 82%), rgb(255 255 255 / 0.025));
	}

	.application-card p {
		margin: 0.6rem 0 0;
		color: rgb(0 0 0 / 0.52);
		font-size: 0.86rem;
		line-height: 1.65;
	}

	:global(.dark) .application-card p {
		color: rgb(255 255 255 / 0.52);
	}

	.application-icon {
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		border-radius: 0.9rem;
		background: var(--primary);
		color: white;
		font-size: 1.5rem;
		box-shadow: 0 0.7rem 1.5rem color-mix(in oklch, var(--primary) 24%, transparent);
	}

	.mail-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		width: 100%;
		margin-top: auto;
		padding: 0.75rem 1rem;
		border-radius: 0.85rem;
		background: var(--primary);
		color: white;
		font-size: 0.88rem;
		font-weight: 800;
		text-decoration: none;
		transition: transform 180ms ease, filter 180ms ease;
	}

	.mail-button:hover {
		filter: brightness(1.08);
		transform: translateY(-1px);
	}

	.site-info {
		display: grid;
		grid-template-columns: minmax(12rem, 0.35fr) minmax(0, 1fr);
		gap: 1.5rem;
		margin-top: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(0 0 0 / 0.07);
	}

	:global(.dark) .site-info {
		border-color: rgb(255 255 255 / 0.08);
	}

	.site-info-title {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		color: var(--primary);
		font-size: 1.6rem;
	}

	.site-info-title div {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.site-info-title span {
		color: rgb(0 0 0 / 0.76);
		font-size: 0.95rem;
		font-weight: 800;
	}

	:global(.dark) .site-info-title span {
		color: rgb(255 255 255 / 0.8);
	}

	.site-info-title small {
		color: rgb(0 0 0 / 0.38);
		font-size: 0.72rem;
	}

	:global(.dark) .site-info-title small {
		color: rgb(255 255 255 / 0.38);
	}

	.site-info dl {
		display: grid;
		gap: 0.65rem;
		margin: 0;
	}

	.site-info dl > div {
		display: grid;
		grid-template-columns: 5rem minmax(0, 1fr);
		gap: 0.7rem;
		min-width: 0;
	}

	.site-info dt {
		color: rgb(0 0 0 / 0.36);
		font-size: 0.78rem;
		font-weight: 700;
	}

	.site-info dd {
		min-width: 0;
		margin: 0;
		overflow-wrap: anywhere;
		color: rgb(0 0 0 / 0.65);
		font-size: 0.82rem;
	}

	.site-info a {
		color: var(--primary);
	}

	:global(.dark) .site-info dt { color: rgb(255 255 255 / 0.36); }
	:global(.dark) .site-info dd { color: rgb(255 255 255 / 0.65); }

	@media (max-width: 720px) {
		.guide-grid,
		.site-info {
			grid-template-columns: 1fr;
		}
	}

	:global(.dark) .friend-avatar-ring {
		border-color: rgb(255 255 255 / 0.42);
	}

	@media (prefers-reduced-motion: reduce) {
		.friend-card,
		.friend-card-glow {
			transition: none;
		}
	}
</style>
