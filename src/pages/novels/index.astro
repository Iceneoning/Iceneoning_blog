---
import NovelCard from "@components/novel/NovelCard.astro";
import NovelLayout from "@layouts/NovelLayout.astro";
import { getNovelLibrary } from "@utils/novel-utils";

const library = await getNovelLibrary();
const serializingCount = library.filter(
	(record) => record.series.data.status === "连载中",
).length;
const chapterCount = library.reduce(
	(total, record) => total + record.chapters.length,
	0,
);
---

<NovelLayout
	title="小说馆"
	description="冰霓的小说作品与章节目录，在故事里走得慢一点。"
>
	<div class="novel-content-wide novel-library-index">
		<header class="novel-archive-intro" data-pagefind-body data-novel-crystal-root>
			<canvas class="novel-crystal-stars" data-novel-crystal-stars aria-hidden="true"></canvas>
			<div class="novel-archive-ambient" aria-hidden="true"></div>
			<svg class="novel-archive-orbits" viewBox="0 0 1100 390" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
				<defs>
					<linearGradient id="archive-starlight" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0%" stop-color="#b4ceff" stop-opacity="0" />
						<stop offset="40%" stop-color="#c6dfff" stop-opacity=".38" />
						<stop offset="75%" stop-color="#f0faff" stop-opacity=".68" />
						<stop offset="100%" stop-color="#a9c4ff" stop-opacity="0" />
					</linearGradient>
				</defs>
				<ellipse cx="890" cy="174" rx="270" ry="111" transform="rotate(-24 890 174)" />
				<ellipse cx="894" cy="162" rx="215" ry="148" transform="rotate(30 894 162)" />
				<path d="M520 373 C700 310 766 167 1085 114" />
				<circle cx="914" cy="54" r="3" />
				<circle cx="1024" cy="245" r="2" />
			</svg>
			<div class="novel-archive-copy">
				<p class="novel-archive-eyebrow"><span aria-hidden="true">✧</span> ICE'S STORY ARCHIVE <i aria-hidden="true"></i></p>
				<h1 data-pagefind-meta="title" class="novel-archive-title">小说馆</h1>
				<p class="novel-archive-lede">在故事里走得慢一点，让风景多停留一会。</p>
				<div class="novel-archive-divider" aria-hidden="true"><i></i><span>✦</span><i></i></div>
				<div class="novel-archive-meta" aria-label="小说馆概览">
					<span><strong>{library.length}</strong> 部作品</span>
					<span class="novel-archive-separator" aria-hidden="true">·</span>
					<span><strong>{chapterCount}</strong> 个章节</span>
					{serializingCount > 0 && (
						<>
							<span class="novel-archive-separator" aria-hidden="true">·</span>
							<span><strong>{serializingCount}</strong> 部连载</span>
						</>
					)}
				</div>
				<a class="novel-archive-explore" href="#novel-works">
					探索故事 <span aria-hidden="true">↗</span>
				</a>
			</div>
			<div class="novel-archive-verse" aria-hidden="true">
				<span class="novel-archive-verse-star">✧</span>
				<p>有些故事，会在星光里<br />与更远的你相遇。</p>
				<span class="novel-archive-verse-en">A LITTLE UNIVERSE OF STORIES</span>
			</div>
		</header>

		<section class="novel-archive-collection" aria-labelledby="novel-works-heading">
			<div id="novel-works" class="novel-section-heading novel-section-heading-simple novel-archive-heading">
				<div>
					<p class="novel-section-kicker">STORIES <span aria-hidden="true">✧</span></p>
					<h2 id="novel-works-heading" class="novel-section-title">作品</h2>
				</div>
				<p class="novel-section-note">每一个故事，都是通往另一片天空的旅程。</p>
			</div>

			{library.length > 0 ? (
				<div class="novel-archive-books">
					{library.map((record, index) => <NovelCard record={record} featured={index === 0} />)}
				</div>
			) : (
				<section class="novel-archive-empty" aria-label="尚无小说作品">
					<p>故事还在路上</p>
					<span>第一部作品准备好后，会在这里与大家见面。</span>
				</section>
			)}
			{library.length > 0 && (
				<p class="novel-archive-afterword"><span aria-hidden="true">✧</span> MORE STORIES TO COME <span aria-hidden="true">✧</span></p>
			)}
		</section>
	</div>
</NovelLayout>
