---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import JourneyOrbit from "../components/effects/JourneyOrbit.astro";
import { Icon } from "astro-icon/components";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";
import { getDir } from "../utils/url-utils";
import path from "node:path";
import ImageWrapper from "../components/misc/ImageWrapper.astro";

const rawPosts = await getSortedPosts();
const allPosts = await Promise.all(
	rawPosts.map(async (post) => {
		const { remarkPluginFrontmatter } = await post.render();

		return {
			...post,
			stats: {
				words: remarkPluginFrontmatter.words ?? 0,
				minutes: remarkPluginFrontmatter.minutes ?? 1,
				excerpt: remarkPluginFrontmatter.excerpt ?? "",
			},
		};
	}),
);

const grouped: Record<number, typeof allPosts> = {};
for (const post of allPosts) {
	const year = new Date(post.data.published).getFullYear();
	if (!grouped[year]) grouped[year] = [];
	grouped[year].push(post);
}
const groups = Object.entries(grouped)
	.map(([year, posts]) => ({ year: Number(year), posts }))
	.sort((a, b) => b.year - a.year);

function formatDate(date: Date) {
	const month = String(date.getMonth() + 1).padStart(2, "0");
	const day = String(date.getDate()).padStart(2, "0");
	return `${month}-${day}`;
}
function formatDateFull(date: Date) {
	const year = date.getFullYear();
	const month = String(date.getMonth() + 1).padStart(2, "0");
	const day = String(date.getDate()).padStart(2, "0");
	return `${year}-${month}-${day}`;
}
function formatTag(tagList: string[]) {
	return tagList.map((t) => `#${t}`).join(" ");
}
---

<MainGridLayout title={i18n(I18nKey.archive)}>
	<!-- Chronicle view: all routes and posts, grouped by year. -->
	<section id="archive-timeline" class="journey-chronicle">
		<header class="journey-chronicle-hero">
            <JourneyOrbit />
			<div class="journey-section-overline">CHRONICLE / 文章目录</div>
			<h1>时间的航迹。</h1>
			<p>从最近的一站往回走，每个日期都留着一段故事。</p>
			<div class="journey-chronicle-counter">{String(allPosts.length).padStart(2, "0")} <span>篇文章 · 持续记录</span></div>
		</header>
		<div class="journey-chronicle-years">
			{groups.map((group) => (
				<section class="journey-chronicle-year" aria-label={`${group.year} 年文章`}>
					<div class="journey-chronicle-year-label">
						<strong>{group.year}</strong>
						<span>{group.posts.length} {i18n(group.posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}</span>
					</div>
					<ol class="journey-chronicle-list">
						{group.posts.map((post) => (
							<li>
								<a href={getPostUrlBySlug(post.slug)} class="journey-chronicle-item" aria-label={post.data.title}>
									<time datetime={formatDateFull(new Date(post.data.published))}>{formatDate(new Date(post.data.published))}</time>
									<strong>{post.data.title}</strong>
									<span class="journey-chronicle-tags">{formatTag(post.data.tags)}</span>
									<Icon name="material-symbols:arrow-outward-rounded" />
								</a>
							</li>
						))}
					</ol>
				</section>
			))}
		</div>
	</section>
	<!-- Query-based filters are applied in the browser so they also work on a statically built site. -->
	<section id="archive-filter-view" class="hidden" aria-live="polite">
		<header class="journey-filter-heading">
            <JourneyOrbit />
			<div class="filter-glow" aria-hidden="true"></div>
			<div class="relative z-10 flex items-end justify-between gap-4">
				<div>
					<div class="journey-section-overline">CHRONICLE / 分类文章</div>
					<h1 data-filter-title class="m-0 text-2xl font-bold text-black/85 dark:text-white/90">精选文章</h1>
					<p data-filter-description class="mb-0 mt-2 text-sm text-black/50 dark:text-white/50">按内容类型精确筛选</p>
				</div>
				<div class="filter-count shrink-0"><strong data-filter-count>0</strong><span>篇</span></div>
			</div>
		</header>


		<div id="archive-cards" class="journey-filter-list">
			{allPosts.map((post) => (
				<a
					href={getPostUrlBySlug(post.slug)}
					data-tags={JSON.stringify(post.data.tags)}
					data-category={post.data.category ?? ""}
					class:list={["archive-card-item journey-filter-card", { "has-cover": Boolean(post.data.image) }]}
				>
					<div class="journey-filter-card-content">
						<div class="journey-filter-card-meta">
							<time datetime={formatDateFull(new Date(post.data.published))}>
								{formatDateFull(new Date(post.data.published))}
							</time>
							<span class="journey-filter-card-category">{post.data.category || "未分类"}</span>
						</div>
						<h2><span class="winter-reading-line">{post.data.title}</span></h2>
						<p class="journey-filter-card-excerpt"><span class="winter-reading-line">{post.data.description || post.stats.excerpt}</span></p>
						<div class="journey-filter-card-footer">
							<span>{post.stats.words} {i18n(post.stats.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</span>
							<span aria-hidden="true">·</span>
							<span>{post.stats.minutes} {i18n(post.stats.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
							{post.data.tags.length > 0 && (
								<span class="journey-filter-card-tags">{post.data.tags.slice(0, 3).map((tag) => `#${tag}`).join("  ")}</span>
							)}
						</div>
					</div>
					{post.data.image && (
						<div class="winter-archive-cover">
							<ImageWrapper src={post.data.image} basePath={path.join("content/posts/", getDir(post.id))} alt={post.data.title} class="w-full h-full object-cover" />
						</div>
					)}
					<span class="journey-filter-card-action" aria-hidden="true">
						<Icon name="material-symbols:arrow-outward-rounded" />
					</span>
				</a>
			))}
		</div>

		<div id="archive-empty" class="card-base hidden px-6 py-12 text-center">
			<div class="text-4xl" aria-hidden="true">✦</div>
			<h2 class="mb-1 mt-3 text-lg font-bold text-black/70 dark:text-white/75">这里还没有文章</h2>
			<p class="m-0 text-sm text-black/45 dark:text-white/45">换一个分类看看，或稍后再来。</p>
		</div>
	</section>
</MainGridLayout>

<!-- Archive filter visual styles are defined in src/styles/journey.css. -->
