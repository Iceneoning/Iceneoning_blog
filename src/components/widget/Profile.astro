---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
import { getSortedPosts } from "../../utils/content-utils";
import { getPostUrlBySlug } from "../../utils/url-utils";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
const config = profileConfig;
const recentPost = (await getSortedPosts())[0];
---
<section class="journey-passport" aria-label="作者档案">
    <div class="journey-passport-overline"><span>在这里写故事的人</span><span class="journey-passport-seal">冰霓 · ICENEON</span></div>
    <div class="journey-passport-identity">
        <a href={url('/intro/')} aria-label="前往介绍页面" class="journey-passport-portrait">
            <ImageWrapper src={config.avatar || ""} alt="作者头像" class="w-full h-full object-cover" width={400} height={425} />
        </a>
        <div class="journey-passport-person">
            <div class="journey-passport-caption">博客作者</div>
            <h2>{config.name}</h2>
            <span>创作 / 游戏 / 技术</span>
        </div>
    </div>
    <p class="journey-passport-bio">{config.bio}</p>
    {recentPost && <details class="journey-passport-dispatch">
        <summary><span class="journey-passport-signal" aria-hidden="true"></span><span>最近一站</span><time datetime={formatDateToYYYYMMDD(recentPost.data.published)}>{formatDateToYYYYMMDD(recentPost.data.published)}</time></summary>
        <div class="journey-passport-dispatch-content">
            <a href={getPostUrlBySlug(recentPost.slug)}>{recentPost.data.title} <Icon name="material-symbols:arrow-outward-rounded" /></a>
        </div>
    </details>
    <nav class="journey-passport-social" aria-label="社交链接">
        {config.links.map(item => (
            <a href={item.url} rel="me" aria-label={item.name} target={item.url.startsWith("mailto:") ? undefined : "_blank"} class="journey-passport-social-link">
                <Icon name={item.icon} />
                <span>{item.name}</span>
            </a>
        ))}
    </nav>
</section>
