---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;
const entries: CollectionEntry<"posts">[] = page.data;
---
<section class="journey-index" aria-label="文章目录">
    <header class="journey-index-header">
        <div>
            <div class="journey-section-overline">星夜 · 故事仍在继续</div>
            <h2>沿途札记 <span>Notes from the journey</span></h2>
        </div>
        <span class="journey-index-context"><span>本页</span><strong>{entries.length}</strong><span>则</span></span>
    </header>
    <div class="journey-entry-list">
        {entries.map((entry) => (
            <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
            />
        ))}
    </div>
</section>
