---
interface Props {
    badge?: string;
    url?: string;
    label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label} class="journey-category-link">
    <span class="journey-category-label"><slot /></span>
    {badge !== undefined && badge !== null && badge !== "" && <span class="journey-category-count">{badge}</span>}
</a>
