---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";


const links = navBarConfig.links;
const isNovelPage = Astro.url.pathname.startsWith("/novels/");
const crossesLayoutBoundary = (href: string) =>
	isNovelPage !== href.startsWith("/novels/");
---
<header id="navbar" class="journey-topbar">
    <div class="journey-topbar-inner card-base">
        <a href={url('/')} data-no-swup={isNovelPage ? "true" : undefined} class="journey-wordmark" aria-label={`返回首页：${siteConfig.title}`}>
            <span class="journey-wordmark-seal" aria-hidden="true">
                <svg viewBox="0 0 52 52" fill="none" focusable="false">
                    <path d="M13 12Q23 6 32 9L40 18V42Q26 37 13 43Z" fill="currentColor" fill-opacity=".07" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M32 9V18H40M18 23L30 21M18 28L32 26M19 33L30 31" stroke="currentColor" stroke-width=".9" opacity=".7"/>
                    <path d="M8 43L19 29M12 38L7 34M12 38L18 38M16 33L12 28M16 33L21 33M9 42L5 40" stroke="currentColor" stroke-width=".7"/>
                    <path d="M14 12Q24 7 31 10" stroke="white" stroke-width="1.1" opacity=".8"/>
                </svg>
            </span>
            <span class="journey-wordmark-type">
                <strong>{siteConfig.title}</strong>
                <small>写故事 · 做游戏 · 记旅途</small>
            </span>
        </a>
        <nav class="journey-nav hidden lg:flex" aria-label="主导航">
            {links.map((l, i) => (
                <a
                    aria-label={l.name}
                    href={l.external ? l.url : url(l.url)}
                    target={l.external ? "_blank" : undefined}
                    rel={l.external ? "noopener noreferrer" : undefined}
                    data-no-swup={!l.external && crossesLayoutBoundary(l.url) ? "true" : undefined}
                    data-journey-route={!l.external ? "true" : undefined}
                    class="journey-nav-item"
                >
                    <span class="journey-nav-index">{String(i + 1).padStart(2, "0")}</span>
                    <span class="journey-nav-name">{l.name}</span>
                </a>
            ))}
        </nav>
        <div class="journey-topbar-tools">
            <Search client:load />
            {!siteConfig.themeColor.fixed && (
                <button aria-label="显示设置" class="journey-topbar-icon btn-plain h-11 w-11" id="display-settings-switch">
                    <Icon name="material-symbols:palette-outline" class="text-xl" />
                </button>
            )}
            <button aria-label="菜单" name="菜单" class="journey-topbar-icon btn-plain h-11 w-11 lg:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-xl" />
            </button>
        </div>
        <NavMenuPanel links={links} isNovelPage={isNovelPage} />
        <DisplaySettings client:load />
    </div>
</header>

<script>
function updateJourneyCurrentLink() {
    const current = new URL(window.location.href);
    document.querySelectorAll<HTMLAnchorElement>("#navbar [data-journey-route]").forEach((item) => {
        const destination = new URL(item.href, window.location.origin);
        const matches = destination.pathname === current.pathname &&
            destination.searchParams.toString() === current.searchParams.toString();
        if (matches) item.setAttribute("aria-current", "page");
        else item.removeAttribute("aria-current");
    });
}

function bindNavbarButtons() {
    updateJourneyCurrentLink();
    const settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            const settingPanel = document.getElementById("display-setting");
            settingPanel?.classList.toggle("float-panel-closed");
        };
    }

    const menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            const menuPanel = document.getElementById("nav-menu-panel");
            menuPanel?.classList.toggle("float-panel-closed");
        };
    }
}

function setupNavbarButtonLifecycle() {
    bindNavbarButtons();

    const attachSwupHook = () => {
        if (!window.swup?.hooks) return;
        window.swup.hooks.on("page:view", bindNavbarButtons);
    };

    if (window.swup?.hooks) {
        attachSwupHook();
    } else {
        document.addEventListener("swup:enable", attachSwupHook, { once: true });
    }
}

setupNavbarButtonLifecycle();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
let pagefindPromise;

async function loadPagefind() {
    if (window.pagefind) {
        document.dispatchEvent(new CustomEvent('pagefindready'));
        return window.pagefind;
    }

    if (pagefindPromise) return pagefindPromise;

    pagefindPromise = (async () => {
    try {
        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        return pagefind;
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        return undefined;
    }
    })();

    return pagefindPromise;
}

document.addEventListener('pagefind:request', loadPagefind);
</script>}
