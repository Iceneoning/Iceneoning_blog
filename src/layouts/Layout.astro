function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom!.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function applyArchiveFilters() {
	const params = new URLSearchParams(window.location.search);
	const tagFilter = params.getAll("tag");
	const categoryFilter = params.getAll("category");
	const uncategorized = params.get("uncategorized");
	const isFiltered = tagFilter.length > 0 || categoryFilter.length > 0 || uncategorized !== null;

	const timeline = document.getElementById("archive-timeline");
	const filterView = document.getElementById("archive-filter-view");
	if (!timeline || !filterView) return;

	timeline.classList.toggle("hidden", isFiltered);
	filterView.classList.toggle("hidden", !isFiltered);
	if (!isFiltered) {
		document.documentElement.removeAttribute("data-archive-filter-pending");
		return;
	}

	const labels: Record<string, { title: string; description: string }> = {
		杂谈: { title: "杂谈", description: "生活见闻、兴趣经历与随想" },
		代码: { title: "代码", description: "编程学习、技术实践与创作记录" },
	};
	const currentLabel = categoryFilter.length === 1 ? labels[categoryFilter[0]] : null;
	const filterTitle = filterView.querySelector<HTMLElement>("[data-filter-title]");
	const filterDescription = filterView.querySelector<HTMLElement>("[data-filter-description]");
	if (filterTitle) filterTitle.textContent = currentLabel?.title ?? tagFilter[0] ?? categoryFilter[0] ?? "精选文章";
	if (filterDescription) filterDescription.textContent = currentLabel?.description ?? "按文章元数据精确筛选";

	let visibleCount = 0;
	const cards = filterView.querySelectorAll<HTMLElement>(".archive-card-item");
	for (const card of cards) {
		const tags: string[] = JSON.parse(card.dataset.tags || "[]");
		const category = card.dataset.category || "";
		let matches = true;
		if (matches && tagFilter.length > 0) matches = tagFilter.some((tag) => tags.includes(tag));
		if (matches && categoryFilter.length > 0) matches = categoryFilter.includes(category);
		if (matches && uncategorized !== null) matches = !category;
		card.classList.toggle("hidden", !matches);
		if (matches) visibleCount += 1;
	}

	const count = filterView.querySelector<HTMLElement>("[data-filter-count]");
	if (count) count.textContent = String(visibleCount).padStart(2, "0");
	document.getElementById("archive-empty")?.classList.toggle("hidden", visibleCount > 0);
	document.documentElement.removeAttribute("data-archive-filter-pending");
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	applyArchiveFilters();
}

/* Load settings when entering the site */
init();

const setup = () => {
	window.swup.hooks.on('visit:start', () => {
		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('page:view', () => {
		loadTheme()
		loadHue()
		applyArchiveFilters()
		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.add('hidden')
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		setTimeout(() => {
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}

            // Just make the transition looks better
            const toc = document.getElementById('toc-wrapper');
            if (toc) {
                toc.classList.remove('toc-not-ready')
            }
        }, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let scrollFrame: number | null = null
function scrollFunction() {
	scrollFrame = null
	const threshold = window.innerHeight * (BACK_TO_TOP_SHOW_THRESHOLD_VH / 100)
	const hasPassedThreshold = window.scrollY > threshold

	if (backToTopBtn) {
		backToTopBtn.classList.toggle('hide', !hasPassedThreshold)
	}
}

function scheduleScrollUpdate() {
	if (scrollFrame !== null) return
	scrollFrame = requestAnimationFrame(scrollFunction)
}

window.addEventListener('scroll', scheduleScrollUpdate, { passive: true })
window.addEventListener('resize', scheduleScrollUpdate, { passive: true })

scheduleScrollUpdate()

</script>

<script>
let lightbox: any = null
let pswpPromise: Promise<any> | null = null

function installPhotoSwipeStyles(...stylesheets: string[]) {
	const styleId = "photoswipe-styles"
	if (document.getElementById(styleId)) return

	const style = document.createElement("style")
	style.id = styleId
	style.textContent = stylesheets.join("\n")
	document.head.appendChild(style)
}

function loadPhotoSwipe() {
	pswpPromise ??= import("photoswipe")
	return pswpPromise
}

async function createPhotoSwipe() {
	const hasImages = document.querySelector(".custom-md img, #post-cover img")
	if (!hasImages) return

	lightbox?.destroy?.()

	loadPhotoSwipe()

	const [
		{ default: PhotoSwipeLightbox },
		{ default: photoSwipeBaseStyles },
		{ default: photoSwipeThemeStyles },
	] = await Promise.all([
		import("photoswipe/lightbox"),
		import("photoswipe/style.css?inline"),
		import("../styles/photoswipe.css?inline"),
	])
	installPhotoSwipeStyles(photoSwipeBaseStyles, photoSwipeThemeStyles)

	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: loadPhotoSwipe,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData: any, element: Element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src
			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)
			itemData.msrc = element.src
		}
		return itemData
	})

	lightbox.init()
}

const setup = () => {
	createPhotoSwipe()
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})
	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>
