---
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/latin-700.css";
import "../styles/main.css";
import "../styles/journey.css";
import "../styles/scrollbar.css";
import "../styles/transition.css";
import "../styles/variables.styl";
import "../styles/winter-art.css";
import "../styles/winter-crystal.css";
import "../styles/winter-type.css";
import "../styles/winter-journal.css";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import MouseSparkEffect from "@components/effects/MouseSparkEffect.astro";

import roboto400 from "@fontsource/roboto/files/roboto-latin-400-normal.woff2";
import roboto700 from "@fontsource/roboto/files/roboto-latin-700-normal.woff2";
import { backgroundConfig, profileConfig, siteConfig } from "@/config";
import {
	DARK_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { THEME_COLOR_PRESETS } from "../utils/setting-utils";
import { url } from "../utils/url-utils";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	image?: string;
	canonical?: string;
}

let { title, description, lang, setOGTypeArticle, image, canonical } = Astro.props;

// defines global css variables
const configHue = siteConfig.themeColor.hue;
const themeColorPresets = THEME_COLOR_PRESETS;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.subtitle
		? `${siteConfig.title} - ${siteConfig.subtitle}`
		: siteConfig.title;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
const pageDescription = description || siteConfig.description;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const backgroundImageUrl = backgroundConfig.src.startsWith("/")
	? url(backgroundConfig.src)
	: backgroundConfig.src;
const mobileBackgroundImageUrl = backgroundConfig.mobileSrc.startsWith("/")
	? url(backgroundConfig.mobileSrc)
	: backgroundConfig.mobileSrc;
const enableVideoBackground = backgroundConfig.enable && backgroundConfig.mode === "video";
const backgroundVideoUrl = backgroundConfig.videoSrc.startsWith("/")
	? url(backgroundConfig.videoSrc)
	: backgroundConfig.videoSrc;

const socialImageUrl = image
	? image.startsWith("http://") || image.startsWith("https://")
		? image
		: new URL(url(image), Astro.site).href
	: undefined;
---

<!DOCTYPE html>
<html lang={siteLang} class="dark bg-[var(--page-bg)] transition text-[14px] md:text-[16px]">
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={pageDescription}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={pageDescription}>
		{canonical && <link rel="canonical" href={canonical}>}
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}
		{socialImageUrl && <meta property="og:image" content={socialImageUrl}>}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={pageDescription}>
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl}>}

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DARK_MODE, PAGE_WIDTH, configHue, themeColorPresets}}>
			// Night-only palette; an old saved light/auto preference must not flash on load.
			document.documentElement.classList.add('dark');
			localStorage.setItem('theme', DARK_MODE);
			const themeColorStorageVersion = 'v2';
			const themeColorVersionKey = 'theme-color-version';

			// Load the hue from local storage
			const parseHue = (value) => {
				const parsed = Number.parseInt(String(value), 10);
				return Number.isFinite(parsed) ? parsed : Number.parseInt(String(configHue), 10);
			};
			const getCircularDistance = (from, to) => {
				const diff = Math.abs(from - to) % 360;
				return Math.min(diff, 360 - diff);
			};
			if (localStorage.getItem(themeColorVersionKey) !== themeColorStorageVersion) {
				localStorage.setItem(themeColorVersionKey, themeColorStorageVersion);
				localStorage.setItem('hue', String(configHue));
			}
			const storedHue = parseHue(localStorage.getItem('hue') || configHue);
			const normalizedHue = ((storedHue % 360) + 360) % 360;
			const preset = themeColorPresets.reduce((closest, current) => {
				return getCircularDistance(normalizedHue, current.hue) < getCircularDistance(normalizedHue, closest.hue)
					? current
					: closest;
			});
			localStorage.setItem('hue', String(preset.hue));
			localStorage.setItem(themeColorVersionKey, themeColorStorageVersion);
			document.documentElement.style.setProperty('--hue', String(preset.hue));
			document.documentElement.style.setProperty('--primary', preset.hex);
			document.documentElement.style.setProperty('--theme-chroma-scale', String(preset.chromaScale));
		</script>
		<!-- Guard query-filtered archive routes before the first paint. -->
        <script is:inline>
            const archiveParams = new URLSearchParams(window.location.search);
            if (/\/archive\/?$/.test(window.location.pathname) &&
                (archiveParams.has("category") || archiveParams.has("tag") || archiveParams.has("uncategorized"))) {
                document.documentElement.setAttribute("data-archive-filter-pending", "");
            }
        </script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>
		{backgroundConfig.enable && <link rel="preload" href={backgroundImageUrl} as="image" fetchpriority="high" />}
		<link rel="preload" href={roboto400} as="font" type="font/woff2" crossorigin>
		<link rel="preload" href={roboto700} as="font" type="font/woff2" crossorigin>

	</head>
	<body class="min-h-screen transition">
		{backgroundConfig.enable && (
			<>
				<div id="site-bg-image" aria-hidden="true" style={`--site-bg-desktop-image: url('${backgroundImageUrl}'); --site-bg-mobile-image: url('${mobileBackgroundImageUrl}')`}></div>
				{enableVideoBackground && (
					<video
						id="site-bg-video"
						aria-hidden="true"
						autoplay muted loop playsinline preload="none"
						data-src={backgroundVideoUrl}
						style={`--site-video-position: ${backgroundConfig.videoPosition}`}
					></video>
				)}
				<div id="site-bg-frosted" aria-hidden="true"></div>
			</>
		)}
		<div id="site-content">
			<ConfigCarrier></ConfigCarrier>
			<MouseSparkEffect></MouseSparkEffect>
			<slot />

			<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
			<div id="page-height-extend" class="hidden h-[300vh]"></div>
		</div>
	</body>
</html>

<style is:global define:vars={{
	'site-bg-blur': `${backgroundConfig.blur}px`,
	'site-bg-overlay-light': backgroundConfig.overlayLight,
	'site-bg-overlay-dark': backgroundConfig.overlayDark,
	'site-bg-scale': backgroundConfig.scale,
}}>
@tailwind components;
@layer components {
	#site-content {
		position: relative;
		z-index: 1;
	}
	#site-bg-image {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background-image: var(--site-bg-desktop-image);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		transform: translate3d(var(--site-bg-parallax-x, 0px), var(--site-bg-parallax-y, 0px), 0) scale(var(--site-bg-scale));
		transform-origin: center;
		will-change: transform;
	}
	#site-bg-video {
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--site-video-position, center);
		pointer-events: none;
		transform: translate3d(var(--site-bg-parallax-x, 0px), var(--site-bg-parallax-y, 0px), 0) scale(var(--site-bg-scale));
		transform-origin: center;
		will-change: transform;
		opacity: 0;
		transition: opacity .65s ease;
	}
	#site-bg-video.is-ready { opacity: 1; }
	@media (max-width: 900px), (pointer: coarse), (prefers-reduced-motion: reduce) {
		#site-bg-video { display: none; }
	}
	#site-bg-frosted {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		-webkit-backdrop-filter: blur(var(--site-bg-blur));
		backdrop-filter: blur(var(--site-bg-blur));
		background: rgba(255, 255, 255, var(--site-bg-overlay-light));
	}
	:root.dark #site-bg-frosted {
		background: rgba(10, 14, 20, var(--site-bg-overlay-dark));
	}
	/* Mobile uses a dedicated saved illustration, not the desktop MP4 poster. */
	@media (max-width: 900px) {
		#site-bg-image {
			background-image: var(--site-bg-mobile-image);
			background-position: center;
			--site-bg-scale: 1.03;
		}
	}
}
</style>

<script>
// Persistent global wallpaper: keep these modules in the actual Layout bundle,
// not inside a conditional Astro component whose scripts may not be emitted.
import "../scripts/background-video";
import "../scripts/background-parallax";
// The oversized journey carousel was retired; the compact homepage is static.
import "../scripts/novel-progress";
import "../scripts/novel-showcase";
import "../scripts/novel-hero-effects";
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import { BACK_TO_TOP_SHOW_THRESHOLD_VH } from "../constants/constants";

/* Preload fonts */
